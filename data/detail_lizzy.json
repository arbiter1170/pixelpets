 "scenes": {
  "lizzy_intro": [
   [
    "say",
    "Lizzy",
    "{name}! Look who it is! Come here, let me look at you."
   ],
   [
    "say",
    "Lizzy",
    "Your mom said Ilse gave you a partner today. And this must be {pet}. Hi, {pet}!"
   ],
   [
    "say",
    "",
    "A big golden Walkling bounds over and sniffs {pet} very politely."
   ],
   [
    "say",
    "Lizzy",
    "That's Buddy. He's been with me since I was about your age. He likes you already."
   ],
   [
    "choice",
    "",
    [
     [
      "Hug Buddy",
      [
       [
        "say",
        "",
        "Buddy leans his whole weight into you. His tail thumps the grass."
       ],
       [
        "setFlag",
        "story.lizzy_hug",
        true
       ]
      ]
     ],
     [
      "Hi, Lizzy!",
      [
       [
        "say",
        "Lizzy",
        "Hi yourself, kiddo. You grew a whole head since summer."
       ]
      ]
     ]
    ]
   ],
   [
    "say",
    "Lizzy",
    "I teach at the new schoolhouse now. Fundamentals, and how to use Walklings for good."
   ],
   [
    "if",
    "!story.rival1_done",
    [
     [
