  "slicePatch": {
    "maps": {
      "fernbrook": {
        "_note": "FACTION_PICK_TIMING v0.2.4 §7 step 1 (design ffada0b): the OR gates of §7.1. maps_slice.json and act1_route2.json stay verbatim, so their changed objects are restated here by id with only `when` changed. Each OR sits in its own when entry; '|' splits before '&'. Nothing sets story.crates_seen yet, so every gate reads as before on every save. DAY1_TRIAL1_FLOW v0.4 (Vincent, Nov 2, 2026): the Hall door opens on Lizzy's class (D1169; the OR terms keep old saves open, D1172 no), Fen leaves the orchard after her go-home talk (D1166), Tobin's battle waits for the pick (before it he is the tally, detail_zz_day1.json), the crates are Part A's taps (the §7.2 guard sits in each line key), the Hall sign drops 'A Keepers' Hall' (D1170 as amended), and a Glimmer save's teaser is the glimmer Rook only.",
        "replaceObjs": [
          {"kind": "door", "id": "fb_lantern", "x": 5, "y": 5, "panel": "lantern", "keeper": "Keeper Amos", "to": "fb_lantern_in", "tx": 5, "ty": 14, "facing": "up"},
          {"kind": "door", "id": "fb_hall", "x": 22, "y": 6, "panel": "hall1", "need": "story.lizzy_class | story.orchard_cleared | story.seal1", "deny": {"!story.crates_seen": "The Hall is shut for now. Tobin could use a hand with his crates first.", "else": "The Hall is shut. A note on the door: 'Away on Keeper business. Back soon. — Fen'"}, "to": "fb_hall_in", "tx": 7, "ty": 22, "facing": "up"},
          {"kind": "warp", "id": "fb_east", "x": 31, "y": 8, "to": "route2", "tx": 1, "ty": 8, "facing": "right", "when": ["story.seal1", "story.side_pick_done | story.orchard_cleared"], "setFlag": "story.reached_route2"},
          {"kind": "sign", "id": "fb_sign_route2_open", "x": 29, "y": 7, "when": ["story.seal1", "story.side_pick_done | story.orchard_cleared"], "text": "ROUTE 2 · Open again! Rockslide cleared by Glimmerwell Co. Brighter by nature."},
          {"kind": "prop", "id": "fb_rubble", "x": 31, "y": 8, "sprite": "rubble", "when": ["!story.seal1 | !story.side_pick_done & !story.orchard_cleared"]},
          {"kind": "sign", "id": "fb_sign_route2", "x": 29, "y": 7, "when": ["!story.seal1 | !story.side_pick_done & !story.orchard_cleared"], "text": "ROUTE 2 · Closed after a rockslide. The crews say: soon!"},
          {"kind": "npc", "id": "rook_fb", "name": "Rook", "x": 22, "y": 8, "when": ["seal:seal_fernbrook", "!story.slice_end", "story.side_pick_done | story.orchard_cleared", "!story.side=glimmer"], "scene": "teaser"},
          {"kind": "trigger", "id": "fb_teaser", "x": 22, "y": 6, "r": 0, "when": ["seal:seal_fernbrook", "!story.slice_end", "story.side_pick_done | story.orchard_cleared", "!story.side=glimmer"], "scene": "teaser"},
          {"kind": "npc", "id": "fen_orchard", "name": "Master Fen", "x": 10, "y": 9, "when": ["!story.orchard_cleared", "!story.fen_sent_home"], "scene": "fen_intro", "lines": {"!story.side_pick_done & !story.orchard_cleared & story.tl_done & !story.crates_seen": "@fen_dusk", "!story.side_pick_done & !story.orchard_cleared & story.crates_seen": "@fen_home", "!story.side_pick_done & !story.orchard_cleared & story.tally_done & !story.tl_done": "Evening's coming. Keeper Amos could use a hand at the Lantern House.", "else": "The crates are by the gate. The Hall can wait."}},
          {"kind": "trainer", "id": "fern_associate", "x": 9, "y": 14, "when": ["!story.side=glimmer", "story.side_pick_done | story.orchard_cleared"]},
          {"kind": "prop", "id": "fb_crate_a", "x": 14, "y": 16, "sprite": "crate", "when": ["!story.orchard_cleared"], "lines": {"!story.side_pick_done & !story.crate_a": "@crate_a", "else": "Tobin's chalk mark on the lid: counted."}},
