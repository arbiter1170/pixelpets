  "flags": {
    "story.rook_quit": "Path-conditional (D25, Oct 19, 2026). \"r5\" on Keepers (left at the cart, or backfill on rook_road). Unset on Glimmer unless the player accepts rook_offer (then \"offer\"). Never written by rook_road@glimmer.",
    "story.rc_start": "Quest accepted at rook_road / rook_road@glimmer.",
    "story.rc_c1": "Crate 1 handled.",
    "story.rc_c2": "Crate 2 handled.",
    "story.rc_c3": "Crate 3 handled.",
    "story.rc_freed": "Counter: crates opened (Keepers side).",
    "story.rc_stamped": "Counter: crates stamped (Glimmerwell side).",
    "story.rc_loose": "Counter: lids left loose (Glimmerwell side).",
    "story.rc_tobin": "oneShot prefix for rc_tobin (engine writes rc_tobin_done / rc_tobin_result).",
    "story.rival3": "oneShot prefix for rival3_rook (engine writes rival3_done / rival3_result).",
    "story.rc_end": "\"freed\" | \"walked\" | \"shipped\". Written once at the climax.",
    "story.rc_climax": "Climax finished; Rook's offer is now live.",
    "story.rc_done": "Wrap-up reward taken; chain finished.",
    "story.switch_via": "\"rook\" for every switch from now on; \"desk\" back-filled on load for saves with story.switches > 0 and no switch_via."
  }
