          {"kind": "prop", "id": "dream_blocks", "x": 1, "y": 6, "sprite": "dream_blocks", "lines": {"else": "Wooden blocks, stacked and still."}},
          {"kind": "prop", "id": "dream_shelf", "x": 7, "y": 6, "sprite": "dream_shelf", "lines": {"else": "A low shelf. A round plush sits on it."}},
          {"kind": "prop", "id": "dream_lamp", "x": 1, "y": 2, "sprite": "lamp_stand", "lines": {"else": "A small lamp by the wall."}},
          {"kind": "prop", "id": "dream_cushion", "x": 7, "y": 4, "sprite": "dream_cushion", "lines": {"else": "A soft cushion on the floor."}}
