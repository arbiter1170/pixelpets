  "scenes": {
    "gb_invite": [
      ["say", "Dorian Pell", "Junior Bright! The Capital wants a word. A Partnership Briefing, up in the Heights."],
      ["if", "chip:any", [
        ["say", "Dorian Pell", "{chip} is a relay now. It carries the signal so other Walklings can read it. Isn't that lovely?"],
        ["say", "Dorian Pell", "Next quarter, holder lanyards with a little listening built in. But that's next quarter!"],
        ["setFlag", "story.gb_invited", true]
      ], [
        ["say", "Dorian Pell", "No relay yet? Then borrow ours. This crate is on loan. Bring it back humming."],
        ["say", "Dorian Pell", "Next quarter, holder lanyards with a little listening built in. But that's next quarter!"],
        ["setFlag", "story.gb_loan", true],
        ["setFlag", "story.gb_invited", true]
      ]]
    ],
    "gb_relay": [
      ["say", "Field Lead Imogen", "Relay mode, on. Stand {chip} by the lamps, sweetie. Quarterly targets."],
      ["say", "", "{chip} starts to hum. Three sleepy Walklings get up and walk toward the open crates."],
      ["relay", "start"],
      ["choice", "", [
        ["Let it hum", [
          ["relay", "ship"],
          ["say", "", "The lids close. The crates hum along with {chip} all the way down the road."],
          ["standing", "glimmer", null, "gb_relay_g"],
          ["align", "glimmer", 5],
          ["setFlag", "story.gb_relay_let", true]
        ]],
        ["Call it back", [
          ["relay", "scatter"],
          ["say", "", "{chip} stops. The three blink, shake off the lamp light and scatter into the roots."],
          ["say", "Field Lead Imogen", "I'll log that as a minor outage. Again. Have a bright day."],
          ["standing", "keepers", null, "gb_callback_k"],
          ["align", "keepers", 5],
          ["setFlag", "story.gb_relay_back", true]
        ]]
      ]],
      ["battle", "gb_imogen"],
      ["setFlag", "story.gb_relay_done", true]
    ],
    "gb_hollis": [
      ["say", "Associate Hollis", "I counted, {name}. The lamps don't count glow. They count Walklings."],
      ["say", "Associate Hollis", "Nobody's taken a chip out. Nobody's tried. I asked."],
      ["choice", "", [
        ["Keep it between us", [
          ["say", "Associate Hollis", "Then it stays here. I will not write it down."],
          ["align", "keepers", 5],
          ["setFlag", "story.gb_hollis_kept", true],
          ["setFlag", "story.gb_hollis", true]
        ]],
        ["Tell Imogen", [
          ["say", "Associate Hollis", "Then I'll take the quarry count. No harm. Just a move."],
          ["align", "glimmer", 5],
          ["setFlag", "story.gb_hollis_told", true],
          ["setFlag", "story.gb_hollis", true]
        ]]
      ]]
    ],
    "gb_escort": [
      ["say", "Associate Juniper", "Partner! Smile, and mean it. The stairs are open for you today."],
      ["setFlag", "story.gb_escort", true]
    ],
    "gb_read": [
      ["setFlag", "story.arbiter_test_active", true],
      ["readWalk", "to"],
      ["say", "", "{chip} walks to the cradle on its own. You say its name. It does not turn around."],
      ["say", "", "Mint light runs along its fur, then back down into the floor."],
      ["readWalk", "back"],
      ["say", "", "{chip} blinks, finds you, and comes back. A little slower than it left."],
      ["if", "story.rx_bitlet", [
        ["say", "", "Bitlet's cursor flickers. COUNT. GATHER. LISTEN. Then, smaller: IT IS NOT SAYING HELLO."]
      ], [
        ["say", "", "The terminal cursor flickers. COUNT. GATHER. LISTEN. Then, smaller: IT IS NOT SAYING HELLO."]
      ]],
      ["readJoy"],
      ["setFlag", "story.arbiter_test_active", false]
    ],
    "gb_briefing": [
      ["standing", "glimmer", null, "gb_brief_g"],
      ["if", "!chip:any", [
        ["if", "!story.gb_tune_asked", [
          ["say", "Associate Quinn", "The Tuning is still open, once. A relay of your own. Not today is fine."],
          ["choice", "", [
            ["Hear the Tuning", [["chipOffer"]]],
            ["Not today", [["setFlag", "story.gb_tune_asked", true]]]
          ]]
        ], []]
      ], []],
      ["say", "Capital Partner", "Quarter Three. Relay coverage is our proudest number. Thank you, holder."],
      ["say", "Capital Partner", "Every team carries one relay. That's policy now. Policy is kindness, written down."],
      ["say", "Associate Quinn", "The cradle reads relays once a quarter. It only takes a moment. Nothing sharp. Nothing cold."],
      ["say", "Associate Quinn", "Every kindness you give it, it passes along. Isn't that a partnership?"],
      ["run", "gb_read"],
      ["say", "Rook", "{name}. It walked to that thing without you."],
      ["choice", "", [
        ["Stand with Glimmerwell", [
          ["align", "glimmer", 5],
          ["setFlag", "story.gb_stand", true]
        ]],
        ["Hold {chip} close", [
          ["align", "keepers", 5],
          ["setFlag", "story.gb_hold", true]
        ]]
      ]],
      ["say", "", "COMING LATER · Glimmerwell's next quarter. Thanks for playing!"],
      ["setFlag", "story.gb_done", true]
    ]
  }
