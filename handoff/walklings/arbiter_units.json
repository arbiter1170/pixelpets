{
  "_about": "ARBITER_UNITS v0.3. Five Walklings Glimmerwell built as its first relays, woken by the Arbiter's hum. Built on main: sprites.js, stats.js, moves.js, game.js, data/detail_route3.json. Spec: handoff/walklings/ARBITER_UNITS.md.",
  "version": "0.3",
  "status": "built on main; names, gate and port settled Oct 27, 2026; copy and tuning open (D837-D853)",
  "settled": {
    "lairs": "Next area only. The branch ships with that area.",
    "origin": "Glimmerwell built them as tools. The hum woke them.",
    "tiers": "Quiet / Humming / Answering",
    "keepers": "Both paths attune the same way. Any holder can hush a unit."
  },
  "_art": "Each stage is an 8-wide half the game mirrors. col maps role letters to PAL keys; e and i are the eyes. No new palette keys. The art is unchanged from v0.1.",
  "groupNames": {
    "glimmer": "the Founder's Line (units)",
    "keepers": "the Answerers"
  },
  "units": [
    {
      "id": "tallybat",
      "name": "Tallybat",
      "builtAs": "a Glow Census counter",
      "role": "speed and stat drops",
      "lore": "Glimmerwell built it to count for the Glow Census. The hum woke it. It still counts everything twice.",
      "look": "A plum bat with navy wing skin and lime wing edges. Humming adds a white tally mark and cyan wing veins. Answering adds a cyan ear tip and a fuller trace.",
      "echo": {
        "id": "recount",
        "name": "Recount",
        "text": "Copies the first boost a foe makes.",
        "rule": "The first time in a battle a foe raises one of its own stats, Tallybat raises the same stat by the same amount.",
        "hook": "applyStage, after the stage is written (game.js ~5630)"
      },
      "clue": {
        "both": "route2: a census post left standing, still counting. New prop through a detail_* overlay (act1_route2 is verbatim)."
      },
      "lair": "An outdoor tally gate where crates are counted.",
      "boss": {
        "level": 26
      }
    },
    {
      "id": "dimlamp",
      "name": "Dimlamp",
      "builtAs": "a Comfort Lamp",
      "role": "wall and slow drain",
      "lore": "A Comfort Lamp that woke when the hum reached Wickerglen. Glimmerwell calls what it does glow sharing.",
      "look": "Lime lamp glass and a grey cap on a dark, round body. Humming adds cyan traces. Answering adds white feet and a white rim on the glass.",
      "echo": {
        "id": "glow_share",
        "name": "Glow Share",
        "text": "Heals a little of the harm it deals.",
        "rule": "After it deals damage, it heals one sixth of that damage, rounded up.",
        "hook": "doMove, after the HP write (game.js ~5588-5592)"
      },
      "clue": {
        "both": "route2_glen: one lamp stand left lit where the Comfort Lamps stood. \"The lamp count came up one short.\" Overlay."
      },
      "lair": "A dim interior rest room, a Comfort Sanctuary.",
      "boss": {
        "level": 27
      }
    },
    {
      "id": "filecrow",
      "name": "Filecrow",
      "builtAs": "a records filing unit",
      "role": "bulky attacker",
      "lore": "Built to file RegenX records for Glimmerwell. The hum woke it beside an old note that only says THE ARBITER.",
      "look": "A dark crow with a pale file-card chest, a gold beak and gold feet. Humming adds a centre crest and lime file tabs on the wings. Answering adds a taller crest, wider wings and a lime bar across the chest.",
      "echo": {
        "id": "filed_away",
        "name": "Filed Away",
        "text": "A repeat hit hurts it less.",
        "rule": "It takes 25% less damage from a move that has already hit it in this battle.",
        "hook": "one hitFoe/setMyHp wrapper before HP is written"
      },
      "clue": {
        "glimmer": "rx_f3: the locked file carts in Records.",
        "keepers": "hm_hq: Mo's archive shelf in the Keeper House.",
        "note": "Twin objects keyed on story.side, same flag. Keepers cannot enter the lab (heights_path)."
      },
      "lair": "A shipping ledger office.",
      "boss": {
        "level": 28
      }
    },
    {
      "id": "cordhound",
      "name": "Cordhound",
      "builtAs": "a crate tether",
      "role": "fast striker",
      "lore": "Built to keep the humming crates in line on the road. When the hum got loud, it chewed through and followed them.",
      "look": "A navy pup with a grey muzzle, lime ear tips and a cord tail ending in a gold plug. Humming adds collar traces. Answering adds taller ears and a doubled plug.",
      "echo": {
        "id": "live_wire",
        "name": "Live Wire",
        "text": "Its first VOLT hit lands harder.",
        "rule": "The first VOLT move it lands in a battle has 1.5x power.",
        "hook": "doMove, before damage()"
      },
      "clue": {
        "both": "cobblecrest cc_crates: a chewed tether trails from the BRINEWICK DOCKS crates down the closed road. Overlay."
      },
      "lair": "The cargo yard where the BRINEWICK DOCKS crates end up.",
      "boss": {
        "level": 29
      }
    },
    {
      "id": "humwisp",
      "name": "Humwisp",
      "builtAs": "the hum's carrier",
      "role": "glass cannon, the last one",
      "lore": "Glimmerwell made a vessel to carry the hum out of the bay. The hum filled it and woke it. The other four answer when it passes.",
      "look": "A navy teardrop with a white and cyan screen mouth and cyan sparks. Humming widens it. Answering adds lime sparks around the outline.",
      "echo": {
        "id": "carrier_hum",
        "name": "Carrier Hum",
        "text": "Foes cannot boost past +1 near it.",
        "rule": "While it is out, a foe cannot raise any of its own stats above +1. Out of battle, the other four in the party gain hum 1.5x.",
        "hook": "applyStage clamp; aiPick treats +1 as the cap (game.js ~5409, ~5422)"
      },
      "clue": {
        "glimmer": "rx_f4: the Arbiter cradle.",
        "keepers": "mahopac: the old mast (mah_signal_mast) picks up the hum.",
        "needs": [
          "story.ans_tallybat",
          "story.ans_dimlamp",
          "story.ans_filecrow",
          "story.ans_cordhound"
        ],
        "note": "Twin objects, same flag. The Arbiter Bay staff door (D92) stays closed."
      },
      "lair": "The place in the next area where the hum is loudest. The Act 2 hook.",
      "boss": {
        "level": 30
      }
    }
  ],
