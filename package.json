{
  "name": "pixelpets",
  "private": true,
  "description": "Local smoke tests for the Walklings browser game. Players open index.html; nothing here is loaded by the game.",
  "scripts": {
    "check:build": "python3 tools/bump_build.py --check",
    "test": "npm run check:build && playwright test",
    "test:agent": "node tools/pp_test.js",
    "test:slow": "node tools/pp_test.js --slow",
    "test:iphone": "playwright test -c tools/playwright.iphone.config.js",
    "iphone": "node tools/iphone_emulate.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.0",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.34.0"
  }
}
