  "scenes": {
    "intro": [
      ["say", "", "Morning! Sunlight pokes through the shutters."],
      ["say", "", "You check the little mirror by the door."],
      ["lookPick"],
      ["say", "", "A note is pinned to your door:"],
      ["say", "", "\"Come to the Warden's Lodge when you wake. Someone small is waiting. — I. Marrow\""],
      ["setFlag", "story.intro_seen", true]
    ],
    "starter": [
      ["say", "Warden Ilse", "There you are! Come in, come in. Mind the baskets, they wriggle."],
      ["if", "!has:name", [["nameEntry", "player", "First things first. What do folk call you?", "Wayfarer", 10]]],
      ["say", "Warden Ilse", "{name}. A good name for the road."],
      ["say", "Warden Ilse", "Every keeper starts with one friend who trusts them. Let me get a feel for you."],
      ["choice", "A storm catches you on the hill path. What do you do?", [["Race it home!", [["say", "Warden Ilse", "Ha! Quick feet and a warm heart."]], "ember"], ["Splash in the puddles", [["say", "Warden Ilse", "Rain never hurt anyone who laughs at it."]], "tide"], ["Wait under a tree", [["say", "Warden Ilse", "Patient. The wild loves a patient keeper."]], "bloom"]]],
      ["choice", "And a shy creature hides from you in the grass?", [["Make it laugh", [], "ember"], ["Sit down and wait", [], "tide"], ["Leave a snack, step back", [], "bloom"]]],
      ["say", "Warden Ilse", "Then I think {suggest} would suit you. But any of them would be lucky. You choose."],
      ["showBasket", {"ember": "A little fire fox with a warm nose and no patience at all. Loves a game of chase.", "tide": "A bubbly water drop, calm as a pond. Nothing ruffles it. Except bath time, oddly.", "bloom": "A sprouting bunny. Shy at first, then braver than anyone I know."}],
      ["givePet", "$line"],
      ["say", "", "{species} hops out of the basket and sniffs your boots."],
      ["nameEntry", "partner", "Give it a name?", null, 10],
      ["say", "Warden Ilse", "{pet} and {name}. I like the sound of that."],
      ["if", "!story.starter_received", [["say", "", "The door bangs open. Rook skids in, out of breath."], ["say", "Rook", "Did I miss it? Aw, you picked already! Then I'll take... that one!"], ["say", "", "Rook scoops up the {rival} basket and grins at you."], ["say", "Rook", "{rivalType} beats {type}, everybody knows that. Meet me at the east gate!"], ["say", "Warden Ilse", "That boy. Well, now you each have someone to grow with."]]],
      ["say", "Warden Ilse", "Feed them, play, let them rest. A bright kindle is the best armour there is."],
      ["give", "heal_snack", 2],
      ["give", "befriend_treat", 3],
      ["respawnHere"],
      ["say", "Warden Ilse", "Snacks for the road, treats for shy ones. The Lantern House by the gate is always lit."],
      ["setFlag", "story.starter_line", "$line"],
      ["setFlag", "story.starter_received", true]
    ],
    "ask_name": [
      ["say", "Warden Ilse", "Ah, {pet}'s keeper! I never did write your name in my ledger."],
      ["nameEntry", "player", "What do folk call you?", "Wayfarer", 10],
      ["say", "Warden Ilse", "{name}. There, it's in the book. Off you go, the Kindlewild is awake."]
    ],
    "rename": [
      ["say", "Warden Ilse", "A new name for my ledger? Easy. I'll just smudge the old one."],
      ["nameEntry", "player", "What should I write down?", "Wayfarer", 10],
      ["say", "Warden Ilse", "{name}. There, freshly inked. It suits you."]
    ],
    "gate_home": [
      ["say", "", "The path out of town is no place to walk alone. Ilse is waiting at the Warden's Lodge."],
      ["push", -1, 0]
    ],
    "rival1": [
      ["say", "Rook", "Hey, wait up! Me and {rival} have been practising. For ten whole minutes."],
      ["battle", "rival1_rook"],
      ["if", "story.rival1_result=won", [["say", "Rook", "Okay, okay, you two are good. Race you to Fernbrook!"]], [["say", "Rook", "Ha! Don't sweat it, the Lantern House fixes everyone up."], ["say", "Rook", "Race you to Fernbrook! Last one there feeds the other one's pet!"]]]
    ],
    "glimmer1": [
      ["say", "Associate Juniper", "Hi there! Free Glimmer lantern? Brighter by nature!"],
      ["say", "Associate Juniper", "Your friend with the spiky hair took two!"],
      ["say", "Associate Juniper", "That grey moth? It just loves our lanterns. It'll perk up! Have a bright day!"],
      ["setFlag", "story.met_glimmerwell", true]
    ],
    "faded1": [
      ["say", "", "A grey Fuzzwick is huddled under the lantern. It barely looks up."],
      ["encounter", "faded_fuzzwick"],
      ["if", "story.faded_fuzzwick", [["say", "Associate Juniper", "Oh! It likes you. Keep it, our gift!"]]]
    ],
    "fen_intro": [
      ["say", "Master Fen", "A Wayfarer! Forgive me, I'm worried. Associates are packing my orchard friends into crates."],
      ["say", "Master Fen", "\"Relocating\", they said. Would you go and see? The Hall can wait."],
      ["setFlag", "story.met_fen", true]
    ],
    "orchard": [
      ["say", "", "The crates pop open. Pomlets tumble out and scurry up the apple trees."],
      ["say", "Master Fen", "Thank you, truly. The Hall is open. Come when you're ready, and bring your best."],
      ["setFlag", "story.orchard_cleared", true]
    ],
    "seal1": [
      ["say", "Master Fen", "This is the Fernbrook Seal. Wear it kindly."],
      ["give", "heal_snack", 2],
      ["say", "Master Fen", "Orchard snacks, too. Growing things need feeding."],
      ["setFlag", "story.seal1", true]
    ],
    "teaser": [
      ["say", "Rook", "You beat Fen? Me too! Well... almost."],
      ["say", "Rook", "Look: Glimmerwell picked me for \"Junior Bright\". Clean energy, Wayfarer!"],
      ["say", "Rook", "See you in Cobblecrest, once they clear that rockslide."],
      ["say", "", "Route 2 opens in the next update. Thanks for playing the slice!"],
      ["setFlag", "story.slice_end", true]
    ]
  }
}
