          "5": "#q.q.q.q.q#",
          "6": "#q..q..q..#"
        }
      },
      "dream_drive": {
        "set": {"skin": "dream_drive", "variants": true},
        "gridRows": {
          "2": "#uvuvuvu#",
          "3": "#..j..j.#",
          "4": "#j.....j#",
          "5": "#..j..j.#"
