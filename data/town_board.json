    "slips": "No slips are pinned up.",
    "bounties": "No creature is named today."
  },
  "towns": {
    "hearthmoor": {
      "masthead": "THE LANTERN POST",
      "slogan": "Leave a light. Leave them wild.",
      "reports": [
        {
          "id": "hm_east_road",
          "text": "The east road is Route 1. The watch walks the street at dusk, lantern in hand."
        },
        {
          "id": "hm_gate_holding",
          "text": "The east gate is holding. Someone left a thermos on the post for the watch.",
          "when": [
            "!story.starter_received"
          ]
        },
        {
          "id": "hm_rook_gate",
          "text": "Rook is at the east gate, waving at anyone who looks lost.",
          "when": [
            "story.starter_received",
            "!story.rival1_done"
          ]
        },
        {
          "id": "hm_north_wait",
          "text": "The north trail can wait. The ferns are thick, and the moss is wet this week.",
          "when": [
            "!story.mom_sent"
          ]
        },
        {
          "id": "hm_north_open",
          "text": "The north trail is open, and time feels thick. Bring a snack and walk slowly.",
          "when": [
            "story.mom_sent"
          ]
        },
        {
          "id": "hm_keeper1",
          "text": "Keeper1 is live. The wires stay with the watch. Ask them if yours goes quiet.",
          "when": [
            "story.phone_got"
          ]
        },
        {
          "id": "hm_mint_vest",
          "text": "A mint vest was seen on the street. The paper here is still Keeper paper.",
          "when": [
            "story.side=glimmer"
          ]
        }
      ]
    },
    "fernbrook": {
      "masthead": "THE LANTERN POST",
      "slogan": "Leave a light. Leave them wild.",
      "reports": [
        {
          "id": "fb_hall_latched",
          "text": "The Trial Hall is latched. Fen is outside, pacing by the steps.",
          "when": [
            "!story.orchard_cleared"
          ]
        },
        {
          "id": "fb_hall_open",
          "text": "The Trial Hall is open. The steps were swept this morning.",
          "when": [
            "story.orchard_cleared",
            "!story.seal1"
          ]
        },
        {
          "id": "fb_rockslide",
          "text": "Route 2 is under the rockslide. The crews are clearing it stone by stone.",
          "when": [
            "!story.seal1"
          ]
        },
        {
          "id": "fb_route2",
          "text": "Route 2 is open toward Wickerglen. Mind the loose gravel past the bend.",
          "when": [
            "story.seal1"
          ]
        },
        {
          "id": "fb_stand",
          "text": "A Glimmerwell stand is on the main street. It is not the town."
        }
      ]
    },
    "cobblecrest": {
      "masthead": "THE LANTERN POST",
      "slogan": "Leave a light. Leave them wild.",
      "reports": [
        {
          "id": "cc_stall",
          "text": "Cairnside Supplies is chalked on the stall. Rope, lamp oil, and warm bread.",
          "when": [
            "!story.quarry_bought"
          ]
        },
        {
          "id": "cc_quarry_road",
          "text": "The quarry road is watched. Walk it in daylight, and say hello to the guard.",
          "when": [
            "!story.quarry_bought"
          ]
        },
        {
          "id": "cc_hale_note",
          "text": "Hale's door has a chalk note about the quarry meeting. Tea after, at the cairn.",
          "when": [
            "!story.quarry_bought",
            "!story.seal2"
          ]
        },
        {
          "id": "cc_stall_bright",
          "text": "Cairnside Supplies is chalked on a brighter stall. The bread is still warm.",
          "when": [
            "story.quarry_bought"
          ]
        },
        {
          "id": "cc_partnership",
          "text": "The quarry is a partnership, the cairn is still the cairn, and visitors are welcome briefly.",
          "when": [
            "story.quarry_bought"
          ]
        },
        {
          "id": "cc_hale_note_bright",
          "text": "Hale's door has a bright chalk note about the quarry meeting. Mint pens provided.",
          "when": [
            "story.quarry_bought",
            "!story.seal2"
          ]
        }
      ],
      "sleeves": [
        {
          "when": [
            "story.quarry_bought"
          ],
          "masthead": "BRIGHT NOTICE",
          "slogan": "Have a bright day."
        }
      ]
    },
    "highcharity": {
      "masthead": "THE LANTERN POST",
      "slogan": "Leave a light. Leave them wild.",
      "reports": [
        {
          "id": "hc_plaza",
          "text": "The plaza is open. The south gate is the coach home. It leaves at every bell."
        },
        {
          "id": "hc_event_hall",
          "text": "The Event Hall is taking games. Sign the sheet by the door."
        },
        {
          "id": "hc_sky_dock",
          "text": "The sky-dock keeps its own boarding board. This post is the town's."
        },
        {
          "id": "hc_market",
          "text": "The Lantern Market is south of this post. Follow the smell of roasted nuts."
        }
      ]
    },
    "mahopac": {
