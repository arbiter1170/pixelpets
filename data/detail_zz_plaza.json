 "scenes": {
  "plaza_ask": [
   ["say", "Officer Vale", "Walk the square for me. Lamps, plaque, then the chalk."],
   ["say", "Officer Vale", "Pryce, Lisse, and Tansy. Then come back."],
   ["choice", "Walk the plaza?", [
    ["I'll walk it", [
     ["say", "Officer Vale", "Start with Pryce. He is just south of me."],
     ["setFlag", "story.plaza_yes", true]
    ]],
    ["Not right now", [
     ["say", "Officer Vale", "The square will keep. So will I."]
    ]]
   ]]
  ],
  "plaza_pryce": [
   ["say", "Keeper Pryce", "Vale sent you. These wicks are trimmed for dusk."],
   ["say", "Keeper Pryce", "Tell Lisse the lamps are ready. She has the plaque."],
   ["setFlag", "story.plaza_pryce", true]
  ],
  "plaza_lisse": [
   ["say", "Cadet Lisse", "The plaque is bright. Vale will want to hear that."],
   ["say", "Cadet Lisse", "Tansy is chalking by the east flower bed."],
   ["setFlag", "story.plaza_lisse", true]
  ],
  "plaza_tansy": [
   ["if", "!story.rival1_done", [
    ["say", "Tansy Holt", "Rook bounced through at dawn. He is at the east gate."]
   ]],
   ["say", "Tansy Holt", "Vale said the chalk can stay. I drew the fountain."],
   ["say", "Tansy Holt", "Tell him the square looks awake."],
   ["setFlag", "story.plaza_tansy", true]
  ],
  "plaza_back": [
   ["say", "Officer Vale", "Pryce, Lisse, and Tansy. The square is in good hands."],
   ["say", "", "{pet} sits a little taller on the paving."],
   ["bond", 2],
   ["setFlag", "story.plaza_done", true]
  ],
  "plaza_sign_ask": [
   ["say", "Officer Vale", "Cald counts the east sign. Read ours, by the gate."],
   ["choice", "Read the plaza sign?", [
    ["I'll read it", [
     ["say", "Officer Vale", "It stands at the east mouth of the square."],
     ["setFlag", "story.plaza_sign_yes", true]
    ]],
    ["Not right now", [
     ["say", "Officer Vale", "The sign will wait."]
    ]]
   ]]
  ],
  "plaza_sign_read": [
   ["say", "", "HEARTHMOOR PLAZA. Keepers' square. East: home lane."],
   ["say", "", "The post is up. Officer Vale wants that."],
   ["setFlag", "story.plaza_sign", true]
  ],
  "plaza_sign_tell": [
   ["say", "Officer Vale", "Still up. East and west both have a sign."],
   ["bond", 2],
   ["setFlag", "story.plaza_sign_done", true]
  ],
  "lantern_ask": [
   ["say", "Officer Vale", "You brought the road home. We light the square tonight."],
   ["choice", "Stay for lantern night?", [
    ["I'll stay", [
     ["say", "Officer Vale", "Pryce lights them. Tansy draws the glow."],
     ["setFlag", "story.lantern_yes", true]
