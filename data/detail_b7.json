          {"kind": "prop", "id": "obs_lamp", "x": 1, "y": 5, "sprite": "lamp_stand", "lines": {"else": "A small lamp. The shade is warm."}},
          {"kind": "prop", "id": "obs_chart", "x": 7, "y": 3, "sprite": "star_roll", "lines": {"else": "A rolled star chart. The ink is pale."}},
          {"kind": "prop", "id": "obs_case", "x": 7, "y": 5, "sprite": "obs_case", "lines": {"else": "A small case. The lid is shut."}}
        ]
      },
      "dream_2004": {
        "set": {"skin": "dream_2004", "variants": true},
