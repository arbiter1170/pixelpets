          {"kind": "prop", "id": "menu_board", "x": 4, "y": 2, "sprite": "menu_board", "lines": {"else": "A menu board. The pictures are plain shapes."}},
          {"kind": "prop", "id": "order_post", "x": 1, "y": 4, "sprite": "order_post", "lines": {"else": "A short post by the lane. No name on it."}}
