{
  "_about": "ARBITER_UNITS v0.1, design draft, Oct 27, 2026. Five Glimmerwell-made SHADE Walklings that hear the Arbiter. Not in the game. Nothing here goes into sprites.js, stats.js or moves.js until Vincent settles D194-D204. Spec: handoff/walklings/ARBITER_UNITS.md.",
  "version": "0.1",
  "status": "draft, waiting on D194-D204",
  "_art": "Each stage is an 8-wide half that the game mirrors, like every SPECIES line. col maps role letters (a main, b belly, c accent, d accent2, x extra) to PAL keys. e and i are the eyes. No new palette keys. The game adds the 1 px outline. Stages are attunement tiers: same name, small changes. Preview one with tools/grid2png.py --id <unit><tier> --scale 4 --out x.png handoff/walklings/arbiter_units.json after pulling units_art out, or open the preview PNGs beside this file.",
  "units": [
    {
      "id": "hushlamp",
      "name": "Hushlamp",
      "role": "wall and healer",
      "lore": "A Comfort Lamp that learned to walk. Its glow is a request, and most things say yes.",
      "look": "Lime lamp glass and a grey cap on a dark, round body. Listening adds cyan traces down the body. In tune adds white feet and a white rim on the glass.",
      "signal": {
        "id": "comfort_glow",
        "name": "Comfort Glow",
        "text": "Mends a little on a turn it rests.",
        "rule": "At the end of a turn in which it used a move with power 0, or used no move, it heals 10% of max HP. Once per turn."
      },
      "clue": {
        "place": "Wickerglen, under the Comfort Lamps",
        "flag": "story.sig_hushlamp_clue"
      },
      "boss": {
        "level": 30,
        "order": 2,
        "site": "[NEXT AREA SITE 2]"
      }
    },
    {
      "id": "cordhound",
      "name": "Cordhound",
      "role": "fast striker",
      "lore": "Paces the night carts on a cord nobody holds. It sits, very still, whenever the cradle hums.",
      "look": "A navy pup with a grey muzzle, lime ear tips, and a cord tail that ends in a gold plug. Listening adds cyan collar traces. In tune adds taller ears and a doubled plug.",
      "signal": {
        "id": "live_wire",
        "name": "Live Wire",
        "text": "Its first VOLT hit lands harder.",
        "rule": "The first VOLT move it lands in a battle has 1.5x power."
      },
      "clue": {
        "place": "Cobblecrest Quarry, the crate yard",
        "flag": "story.sig_cordhound_clue"
      },
      "boss": {
        "level": 32,
        "order": 4,
        "site": "[NEXT AREA SITE 4]"
      }
    },
    {
      "id": "tallybat",
      "name": "Tallybat",
      "role": "speed and debuffs",
      "lore": "Built for the Glow Census. It counts everything twice and never says the total out loud.",
      "look": "A plum bat with navy wing skin and lime wing edges. Listening adds a white tally mark on the chest and cyan wing veins. In tune adds a cyan ear tip and a fuller wing trace.",
      "signal": {
        "id": "recount",
        "name": "Recount",
        "text": "Copies the first boost a foe makes.",
        "rule": "The first time in a battle a foe raises one of its own stats, Tallybat raises the same stat by the same amount."
      },
      "clue": {
        "place": "Route 2, the Glow Census board",
        "flag": "story.sig_tallybat_clue"
      },
      "boss": {
        "level": 28,
        "order": 1,
        "site": "[NEXT AREA SITE 1]"
      }
    },
    {
      "id": "ledgerowl",
      "name": "Ledgerowl",
      "role": "bulky attacker",
      "lore": "Keeps the RegenX Records room company. It has never forgotten a folder, even the old one.",
      "look": "A slate owl with a pale screen face, lime ear tufts, and gold feet. Listening adds dark file stripes on the wings. In tune adds a wider body and a lime bar across the chest.",
      "signal": {
        "id": "filed_away",
        "name": "Filed Away",
        "text": "A repeat hit hurts it less.",
        "rule": "It takes 25% less damage from a move that has already hit it in this battle."
      },
      "clue": {
        "place": "RegenX lab, the Records room",
        "flag": "story.sig_ledgerowl_clue"
      },
      "boss": {
        "level": 31,
        "order": 3,
        "site": "[NEXT AREA SITE 3]"
      }
    },
    {
      "id": "humwisp",
      "name": "Humwisp",
      "role": "glass cannon, the last one",
      "lore": "Drifted out of the Arbiter bay. The other four go quiet when it passes. Nobody will say who built it.",
      "look": "A navy teardrop with a white and cyan screen mouth and cyan trailing sparks. Listening widens the body and the screen. In tune adds lime sparks around the outline.",
      "signal": {
        "id": "carrier_hum",
        "name": "Carrier Hum",
        "text": "Foes cannot boost past +1 near it.",
        "rule": "While it is out, a foe cannot raise any of its own stats above +1."
      },
      "clue": {
        "place": "RegenX lab, the Arbiter bay cradle",
        "flag": "story.sig_humwisp_clue",
        "needs": [
          "story.sig_tallybat_done",
          "story.sig_hushlamp_done",
          "story.sig_ledgerowl_done",
          "story.sig_cordhound_done"
        ]
      },
      "boss": {
        "level": 34,
        "order": 5,
        "site": "[NEXT AREA SITE 5]"
      }
    }
  ],
