  "maps": {
   "fernbrook": {
    "replaceObjs": [
     {
      "kind": "sign",
      "id": "fb_sign_town",
      "x": 2,
      "y": 7,
      "text": "FERNBROOK · Orchard village. Home of the Fernbrook Trial Hall."
     }
    ]
   }
  }
