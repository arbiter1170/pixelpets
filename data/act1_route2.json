  "scenes": {
    "glimmer2": [
      ["say", "", "A soft mint glow pulses at the top of the side path."],
      ["say", "", "Wild Walklings drift toward it, yawning. They look greyer than they should."],
      ["say", "", "{pet} puffs up and stares up the path."],
      ["say", "Associate Hollis", "Glow Census in progress! Nothing to see here. Have a bright day!"],
      ["setFlag", "story.met_census", true]
    ],
    "lead_intro": [
      ["say", "", "Mint lamps hum on tall stands. Walklings doze under them, their colours washed out."],
      ["say", "Field Lead Imogen", "Oh, {name}! Welcome to the Glow Census. Isn't it peaceful?"],
      ["say", "Field Lead Imogen", "Our Comfort Lamps help wild Walklings relax. We just collect a little extra glow."],
      ["choice", "Any questions? Quick ones, please.", [["They look exhausted.", [["say", "Field Lead Imogen", "That's relaxation! It photographs beautifully."]]], ["Turn the lamps off.", [["say", "Field Lead Imogen", "Off? We're on a schedule, sweetie. Quarterly targets."]]]]],
      ["setFlag", "story.met_lead", true]
    ],
    "faded2": [
      ["if", "story.glen_cleared", [["say", "", "A Pebblit, still a little grey, peeks at you from the grass."]], [["say", "", "A grey Pebblit is curled under a lamp, too sleepy to roll away."]]],
      ["encounter", "faded_pebblit"],
      ["if", "story.faded_pebblit", [["say", "", "Pebblit leans on your boot. It already feels a little warmer."]]]
    ],
    "glen_cleared": [
      ["say", "", "Running footsteps crunch up the path."],
      ["say", "Rook", "Delivery for the Glow Census! Twelve more lamps, fresh from... {name}?!"],
      ["say", "Field Lead Imogen", "Ah, our Junior Bright! Tell your friend this is all perfectly comfy."],
      ["say", "Rook", "It is! It's a census. They count Walklings. Right?"],
      ["say", "", "{pet} bumps the nearest lamp stand. It wobbles, and every lamp clicks off at once."],
      ["say", "", "The dozing Walklings blink. A little colour creeps back into fur and feathers."],
      ["say", "Field Lead Imogen", "I'll log that as a minor outage. Have a bright day, both of you."],
      ["say", "", "Imogen packs the lamps into crates and strolls off, humming."],
      ["say", "Rook", "That... didn't look like counting."],
      ["say", "Rook", "They gave me treats to 'calm the units'. Here. You'll use them better."],
      ["give", "befriend_treat", 3],
      ["say", "Rook", "My supervisor's at the Cobblecrest quarry. He'll explain. He always explains."],
      ["setFlag", "story.rook_saw_lamps", true],
      ["setFlag", "story.glen_cleared", true]
    ],
    "route2_end": [
      ["say", "Rook", "Locked. 'Closed for upgrades.' Since when does a quarry need upgrades?"],
      ["say", "Rook", "Master Hale's Trial Hall is up there. He dug with his Walklings, not with lamps."],
      ["choice", "Go up together when it opens?", [["Together.", [["say", "Rook", "Together. But I'm still beating you to the Seal."]]], ["Race you!", [["say", "Rook", "Ha! Now you're talking."]]]]],
      ["say", "", "COMING LATER · Cobblecrest and its Trial Hall. Thanks for playing Route 2!"],
      ["setFlag", "story.route2_end", true]
    ]
  },
