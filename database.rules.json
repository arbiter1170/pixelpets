{
  "rules": {
    ".read": false,
    ".write": false,
    "config": {
      ".read": "auth != null",
      ".write": false
    },
    "roomCodes": {
      ".read": false,
      ".write": false,
      "$code": {
        ".read": "auth != null",
        ".write": false
      }
    },
    "rooms": {
      "$code": {
        "$area": {
          ".read": "auth != null && $code.matches(/^[A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9]$/) && root.child('roomCodes/' + $code + '/on').val() === true && ($area === 'hearthmoor' || $area === 'route1')",
          "$shard": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && $code.matches(/^[A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9]$/) && root.child('roomCodes/' + $code + '/on').val() === true && $shard.matches(/^r[1-9][0-9]?$/) && ($area === 'hearthmoor' || $area === 'route1')",
              ".validate": "newData.hasChildren(['pv', 'x', 'y', 'f', 'look', 'pet', 'seals', 'title', 'vis', 'joined', 'seen', 'pt']) && (!data.child('lastEmoteAt').exists() || (newData.child('lastEmoteAt').exists() && newData.child('lastEmoteAt').val() >= data.child('lastEmoteAt').val())) && (!data.exists() || (newData.child('x').val() === data.child('x').val() && newData.child('y').val() === data.child('y').val() && newData.child('f').val() === data.child('f').val() && newData.child('mv').val() === data.child('mv').val()) || (newData.child('pt').isNumber() && newData.child('pt').val() <= now && newData.child('pt').val() >= data.child('pt').val() + 350))",
              "pv": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 9"
              },
              "x": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && (($area === 'hearthmoor' && newData.val() < 24) || ($area === 'route1' && newData.val() < 48))"
              },
              "y": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && (($area === 'hearthmoor' && newData.val() < 24) || ($area === 'route1' && newData.val() < 20))"
              },
              "f": {
                ".validate": "newData.isString() && newData.val().matches(/^(u|d|l|r)$/)"
              },
              "mv": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 1"
              },
              "busy": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 1"
              },
              "pt": {
                ".validate": "newData.isNumber() && newData.val() <= now && (!data.exists() || newData.val() === data.val() || newData.val() >= data.val() + 350)"
              },
              "look": {
                "sk": {
                  ".validate": "newData.isString() && newData.val().matches(/^(1|2|3|4|5|6)$/)"
                },
                "hr": {
                  ".validate": "newData.isString() && newData.val().matches(/^(short|long|spiky|bun|bob|pony|curls|buzz)$/)"
                },
                "hc": {
                  ".validate": "newData.isString() && newData.val().matches(/^(k|p|r|o|y|l|g|t|n|b|c|s|w|h|m|d)$/)"
                },
                "of": {
                  ".validate": "newData.isString() && newData.val().matches(/^(coat|hoodie|tunic|vest|sweater|dress)$/)"
                },
                "oc": {
                  ".validate": "newData.isString() && newData.val().matches(/^(k|p|r|o|y|l|g|t|n|b|c|s|w|h|m|d)$/)"
                },
                "ac": {
                  ".validate": "newData.isString() && newData.val().matches(/^(k|p|r|o|y|l|g|t|n|b|c|s|w|h|m|d)$/)"
                },
                "ax": {
                  ".validate": "newData.isString() && newData.val().matches(/^(none|glasses|bow|cap|scarf)$/)"
                },
                "$other": {
                  ".validate": "false"
                },
                ".validate": "newData.hasChildren(['sk', 'hr', 'hc', 'of', 'oc', 'ac', 'ax'])"
              },
              "pet": {
                ".validate": "newData.hasChildren(['sp', 'st', 'lv'])",
                "sp": {
                  ".validate": "newData.isString() && newData.val().matches(/^(ember|tide|bloom|stone|volt|frost|gust|shade|beetle|mole|crab|moth|vane|dormouse|byte|fetch)$/)"
                },
                "st": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 2"
                },
                "lv": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100"
                },
                "$other": {
                  ".validate": "false"
                }
              },
              "seals": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 8"
              },
              "title": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 7"
              },
              "vis": {
                ".validate": "newData.isString() && newData.val().matches(/^(a|f)$/)"
              },
              "lastEmoteAt": {
                ".validate": "newData.isNumber() && newData.val() <= now && (!data.exists() || newData.val() === data.val() || (newData.val() === now && newData.val() >= data.val() + 2000))"
              },
              "emote": {
                ".validate": "newData.hasChildren(['id', 't'])",
                "id": {
                  ".validate": "newData.isString() && newData.val().matches(/^(e_wave|e_heart|e_bang|e_ask|e_laugh|e_dots|e_zz|e_clap|e_trick|p_hi|p_nice|p_follow|p_over|p_thanks|p_luck|p_brb|p_bye|p_snack|p_glow|p_seal|p_wild|p_lantern|p_route|p_cozy|p_walk)$/)"
                },
                "t": {
                  ".validate": "newData.isNumber() && newData.val() === now && newData.val() === newData.parent().parent().child('lastEmoteAt').val()"
                },
                "$other": {
                  ".validate": "false"
                }
              },
              "joined": {
                ".validate": "newData.isNumber() && newData.val() <= now && (!data.exists() || newData.val() === data.val())"
              },
              "seen": {
                ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 10000"
              },
              "$other": {
                ".validate": "false"
              }
            }
          }
        }
      }
    },
    "codes": {
      "$fcode": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid) && (!newData.exists() || newData.val() === auth.uid) && root.child('codeOwner/' + auth.uid).val() === $fcode",
        ".validate": "$fcode.matches(/^WLK-[A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9]-[A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9]$/) && newData.isString() && newData.val() === auth.uid"
      }
    },
    "codeOwner": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists()",
        ".validate": "newData.isString() && newData.val().matches(/^WLK-[A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9]-[A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9]$/)"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren()",
        "$other": {
          ".read": "auth != null && auth.uid === $other",
          ".validate": "newData.isBoolean() && newData.val() === true && $other !== $uid && $other.matches(/^[A-Za-z0-9]{1,128}$/)"
        }
      }
    },
    "friendInfo": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('friends/' + $uid + '/' + auth.uid).val() === true)",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren()",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 10 && newData.val().matches(/^[A-Za-z0-9][A-Za-z0-9 '.-]*$/)"
        },
        "pet": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 10 && newData.val().matches(/^[A-Za-z0-9][A-Za-z0-9 '.-]*$/)"
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "blocks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren()",
        "$other": {
          ".validate": "newData.isNumber() && newData.val() <= now && $other !== $uid && $other.matches(/^[A-Za-z0-9]{1,128}$/)"
        }
      }
    },
    "hidden": {
      "$target": {
        ".read": false,
        ".validate": "newData.hasChildren()",
        "$blocker": {
          ".read": "auth != null && auth.uid === $target",
          ".write": "auth != null && auth.uid === $blocker",
          ".validate": "newData.isNumber() && newData.val() <= now && $blocker !== $target && $blocker.matches(/^[A-Za-z0-9]{1,128}$/)"
        }
      }
    },
    "parties": {
      "$code": {
        "inbox": {
          "$to": {
            ".read": "auth != null && auth.uid === $to",
            "$from": {
              ".write": "auth != null && ((auth.uid === $from && (!newData.exists() || (root.child('config/coop/on').val() === true && $code.matches(/^[A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9]$/) && root.child('roomCodes/' + $code + '/on').val() === true))) || (auth.uid === $to && !newData.exists()))",
              ".validate": "newData.hasChildren(['pid', 'at']) && $from !== $to && root.child('parties/' + $code + '/' + newData.child('pid').val() + '/host').val() === $from && root.child('parties/' + $code + '/' + newData.child('pid').val() + '/invites/' + $to).exists()",
              "pid": {
                ".validate": "newData.isString() && newData.val().matches(/^p[A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9]$/)"
              },
              "at": {
                ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 10000"
              },
              "$x": {
                ".validate": false
              }
            }
          }
        },
        "$pid": {
          ".read": "auth != null && $pid.matches(/^p[A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9]$/) && (data.child('members/' + auth.uid).exists() || data.child('invites/' + auth.uid).exists())",
          ".write": "auth != null && $pid.matches(/^p[A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9]$/) && ((!data.exists() && newData.child('host').val() === auth.uid && root.child('config/coop/on').val() === true && $code.matches(/^[A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9]$/) && root.child('roomCodes/' + $code + '/on').val() === true) || (data.exists() && !newData.exists() && data.child('host').val() === auth.uid))",
          ".validate": "newData.hasChildren(['cv', 'host', 'made', 'area', 'members'])",
          "cv": {
            ".validate": "newData.isNumber() && newData.val() === 1 && (!data.exists() || newData.val() === data.val())"
          },
          "host": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9]{1,128}$/) && (!data.exists() || newData.val() === data.val())"
          },
          "made": {
            ".validate": "data.exists() ? newData.val() === data.val() : (newData.isNumber() && newData.val() <= now && newData.val() >= now - 10000)"
          },
          "area": {
            ".write": "auth != null && auth.uid === root.child('parties/' + $code + '/' + $pid + '/host').val() && root.child('config/coop/on').val() === true",
            ".validate": "newData.isString() && newData.val().matches(/^(hearthmoor|route1)$/)"
          },
          "guest": {
            ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid && root.child('config/coop/on').val() === true && root.child('parties/' + $code + '/' + $pid + '/invites/' + auth.uid).exists()) || (data.exists() && !newData.exists() && (data.val() === auth.uid || auth.uid === root.child('parties/' + $code + '/' + $pid + '/host').val())))",
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9]{1,128}$/) && newData.val() !== newData.parent().child('host').val() && (newData.parent().child('invites').child(newData.val()).exists() || root.child('parties/' + $code + '/' + $pid + '/invites/' + newData.val()).exists()) && root.child('friends/' + newData.parent().child('host').val() + '/' + newData.val()).val() === true && root.child('friends/' + newData.val() + '/' + newData.parent().child('host').val()).val() === true && !root.child('blocks/' + newData.val() + '/' + newData.parent().child('host').val()).exists() && !root.child('blocks/' + newData.parent().child('host').val() + '/' + newData.val()).exists()"
          },
          "invites": {
            "$uid": {
              ".write": "auth != null && ((auth.uid === root.child('parties/' + $code + '/' + $pid + '/host').val() && (!newData.exists() || root.child('config/coop/on').val() === true)) || (auth.uid === $uid && !newData.exists()))",
              ".validate": "newData.isNumber() && newData.val() <= now && $uid.matches(/^[A-Za-z0-9]{1,128}$/) && $uid !== newData.parent().parent().child('host').val() && root.child('friends/' + newData.parent().parent().child('host').val() + '/' + $uid).val() === true && root.child('friends/' + $uid + '/' + newData.parent().parent().child('host').val()).val() === true && !root.child('blocks/' + $uid + '/' + newData.parent().parent().child('host').val()).exists() && !root.child('blocks/' + newData.parent().parent().child('host').val() + '/' + $uid).exists()"
            }
          },
          "members": {
            "$uid": {
              ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || root.child('config/coop/on').val() === true)) || (!newData.exists() && auth.uid === root.child('parties/' + $code + '/' + $pid + '/host').val()))",
              ".validate": "newData.hasChildren(['joined', 'seen', 'away']) && ($uid === newData.parent().parent().child('host').val() || $uid === newData.parent().parent().child('guest').val())",
              "joined": {
                ".validate": "data.exists() ? newData.val() === data.val() : (newData.isNumber() && newData.val() <= now && newData.val() >= now - 10000)"
              },
              "seen": {
                ".validate": "newData.isNumber() && newData.val() <= now"
              },
              "away": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 1"
              },
              "awayAt": {
                ".validate": "newData.isNumber() && newData.val() <= now"
              },
              "ready": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 1"
              },
              "pet": {
                ".validate": "newData.hasChildren(['form', 'level', 'hp', 'mv'])",
                "form": {
                  ".validate": "newData.isString() && newData.val().matches(/^[a-z]{2,16}\\/[0-9]$/)"
                },
                "level": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 60"
                },
                "hp": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 999"
                },
                "mv": {
                  ".validate": "newData.isString() && newData.val().matches(/^[a-z_]{2,24}(,[a-z_]{2,24}){0,3}$/)"
                },
                "mood": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 31"
                },
                "chip": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 3"
                },
                "$x": {
                  ".validate": false
                }
              },
              "$x": {
                ".validate": false
              }
            }
          },
          "battle": {
            ".write": "auth != null && auth.uid === root.child('parties/' + $code + '/' + $pid + '/host').val() && (!newData.exists() || root.child('config/coop/on').val() === true)",
            ".validate": "newData.hasChildren(['id', 'seed', 'kind', 'foes', 'turn', 'deadline'])",
            "id": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 999999999"
            },
            "seed": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 4294967295 && ((!data.exists() || newData.val() === data.val()) || newData.parent().child('id').val() !== data.parent().child('id').val())"
            },
            "kind": {
              ".validate": "newData.isString() && newData.val().matches(/^(wild|holder)$/)"
            },
            "tid": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{2,32}$/)"
            },
            "foes": {
              "$i": {
                ".validate": "$i.matches(/^[0-5]$/) && newData.hasChildren(['form', 'level'])",
                "form": {
                  ".validate": "newData.isString() && newData.val().matches(/^[a-z]{2,16}\\/[0-9]$/)"
                },
                "level": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 60"
                },
                "$x": {
                  ".validate": false
                }
              }
            },
            "turn": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 999 && (!data.exists() || newData.val() >= data.val() || newData.parent().child('id').val() !== data.parent().child('id').val())"
            },
            "deadline": {
              ".validate": "newData.isNumber() && newData.val() <= now + 35000"
            },
            "act": {
              "$n": {
                ".validate": "$n.matches(/^[0-9]{1,3}$/)",
                "$uid": {
                  ".write": "auth != null && auth.uid === $uid && root.child('config/coop/on').val() === true && root.child('parties/' + $code + '/' + $pid + '/members/' + $uid).exists() && !data.exists() && $n === root.child('parties/' + $code + '/' + $pid + '/battle/turn').val() + ''",
                  ".validate": "newData.hasChildren(['k'])",
                  "k": {
                    ".validate": "newData.isString() && newData.val().matches(/^(move|swap|bag|leave)$/)"
                  },
                  "id": {
                    ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{1,24}$/)"
                  },
                  "aim": {
                    ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 1"
                  },
                  "$x": {
                    ".validate": false
                  }
                }
              }
            },
            "log": {
              "$n": {
                ".validate": "$n.matches(/^[0-9]{1,3}$/) && newData.isString() && newData.val().length <= 2000"
              }
            },
            "snap": {
              "$n": {
                ".validate": "$n.matches(/^[0-9]{1,3}$/) && newData.isString() && newData.val().length <= 1000"
              }
            },
            "end": {
              ".validate": "newData.hasChildren(['how', 'at'])",
              "how": {
                ".validate": "newData.isString() && newData.val().matches(/^(win|befriended|fled|run|tired|drop|off)$/)"
              },
              "at": {
                ".validate": "newData.isNumber() && newData.val() <= now"
              },
              "$x": {
                ".validate": false
              }
            },
            "$x": {
              ".validate": false
            }
          },
          "scene": {
            ".validate": false
          },
          "$x": {
            ".validate": false
          }
        }
      }
    }
  }
}
