{
  "spec": "ROOK_CROSSROADS",
  "version": "0.1",
  "note": "Rook's Crossroads. Scenes are the settled spec. Standing grants and the Juniper Acorn bonus are applied by the engine, not as scene steps. Pledge desks are retired; only rook_offer switches sides.",
  "scenes": {
    "rook_road": [
      [
        "say",
        "",
        "Rook sits on a crate by the BRINEWICK ROAD sign, no lanyard, swinging his legs."
      ],
      [
        "say",
        "Rook",
        "{name}! The cart left without me. Best walk I never took."
      ],
      [
        "if",
        "!story.rook_quit",
        [
          [
            "setFlag",
            "story.rook_quit",
            "r5"
          ]
        ]
      ],
      [
        "say",
        "Rook",
        "Bad news, though. Three crates are still in the quarry yard. Pebblits, from the Old Seam."
      ],
      [
        "say",
        "Rook",
        "Tobin counts them at the gate tonight. Hale says the seam is still warm. They could go home."
      ],
      [
        "choice",
        "Help them?",
        [
          [
            "Let's free them",
            [
              [
                "setFlag",
                "story.rc_start",
                true
              ],
              [
                "inc",
                "story.rook_bond",
                1
              ],
              [
                "say",
                "Rook",
                "Knew you'd say that. Open the crates gently. I'll go stall Tobin at the gate."
              ]
            ]
          ],
          [
            "Not right now",
            [
              [
                "say",
                "Rook",
                "I'll be right here. The road's closed anyway."
              ]
            ]
          ]
        ]
      ]
    ],
    "rook_road@glimmer": [
      [
        "say",
        "",
        "Rook stands by the BRINEWICK ROAD sign. His mint lanyard is on. He won't meet your eye at first."
      ],
      [
        "say",
        "Rook",
        "{name}. Quinn's Tuning put a chip under the fur. I keep saying our Walklings get stronger."
      ],
      [
        "say",
        "Rook",
        "I want that. I do. I'm still Junior Bright. I'm not walking away from the cord."
      ],
      [
        "say",
        "Rook",
        "Three crates sit in the quarry yard. Tobin wants them stamped for Brinewick."
      ],
      [
        "choice",
        "The crates...",
        [
          [
            "I'll do my job",
            [
              [
                "setFlag",
                "story.rc_start",
                true
              ],
              [
                "say",
                "Rook",
                "Okay. Stamp clean. I'll be at the gate when you're done."
              ]
            ]
          ],
          [
            "You sound unsure",
            [
              [
                "setFlag",
                "story.rc_start",
                true
              ],
              [
                "inc",
                "story.rook_bond",
                1
              ],
              [
                "say",
                "Rook",
                "Maybe. Don't tell Tobin I said that."
              ]
            ]
          ],
          [
            "Not right now",
            [
              [
                "say",
                "Rook",
                "I'll be here. Nobody's loading anything till dusk."
              ]
            ]
          ]
        ]
      ]
    ],
    "rc_open": [
      [
        "say",
        "",
        "The crate hums. Inside, a Pebblit sleeps curled on warm gravel, its glow low and slow."
      ],
      [
        "if",
        "story.side=glimmer",
        [
          [
            "choice",
            "Stamp it?",
            [
              [
                "Stamp: BRINEWICK",
                [
                  [
                    "say",
                    "",
                    "THUNK. The stamp leaves a bright mint star. The Pebblit does not wake."
                  ],
                  [
                    "inc",
                    "story.rc_stamped",
                    1
                  ]
                ]
              ],
              [
                "Leave the lid loose",
                [
                  [
                    "say",
                    "",
                    "You leave the lid loose. The Pebblit sighs in its sleep."
                  ],
                  [
                    "inc",
                    "story.rc_loose",
                    1
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          [
            "say",
            "",
            "{pet} noses the latch. You lift the lid gently. The Pebblit blinks up at the evening."
          ],
          [
            "inc",
            "story.rc_freed",
            1
          ]
        ]
      ],
      [
        "if",
        "story.rc_c1",
        [
          [
            "if",
            "story.rc_c2",
            [
              [
                "if",
                "story.rc_c3",
                [
                  [
                    "say",
                    "",
                    "That was the last crate. Rook is waving from the quarry gate."
                  ]
                ],
                []
              ]
            ],
            []
          ]
        ],
        []
      ]
    ],
    "rc_crate_1": [
      [
        "setFlag",
        "story.rc_c1",
        true
      ],
      [
        "run",
        "rc_open"
      ]
    ],
    "rc_crate_2": [
      [
        "setFlag",
        "story.rc_c2",
        true
      ],
      [
        "run",
        "rc_open"
      ]
    ],
    "rc_crate_3": [
      [
        "setFlag",
        "story.rc_c3",
        true
      ],
      [
        "run",
        "rc_open"
      ]
    ],
    "rc_gate": [
      [
        "if",
        "story.rc_c1",
        [
          [
            "if",
            "story.rc_c2",
            [
              [
                "if",
                "story.rc_c3",
                [
                  [
                    "if",
                    "story.side=glimmer",
                    [
                      [
                        "say",
                        "Associate Tobin",
                        "Colleague! Crates stamped? Dorian checks the count at dawn."
                      ],
                      [
                        "if",
                        "story.rc_stamped>=3",
                        [
                          [
                            "say",
                            "Associate Tobin",
                            "Three bright stars. That's a quarterly target, right there."
                          ]
                        ],
                        [
                          [
                            "say",
                            "Associate Tobin",
                            "One lid is loose. I'll pretend I didn't see. Smile!"
                          ]
                        ]
                      ],
                      [
                        "say",
                        "",
                        "Rook steps between you and the crates. His mint lanyard still hangs. Hands shake once."
                      ],
                      [
                        "say",
                        "Rook",
                        "Tobin, wait. {name} and I need one minute before those lids leave."
                      ],
                      [
                        "say",
                        "Rook",
                        "{name}. Walk away with me, right now. The Pebblits go home to the seam."
                      ],
                      [
                        "say",
                        "Rook",
                        "Then I have to try. Not as a rival. As a friend asking twice."
                      ],
                      [
                        "battle",
                        "rival3_rook"
                      ],
                      [
                        "if",
                        "story.rival3_result=won",
                        [
                          [
                            "say",
                            "Rook",
                            "You're really good, {name}. I hope you're good at the next part too."
                          ]
                        ],
                        [
                          [
                            "say",
                            "Rook",
                            "I won, and it doesn't fix anything. Funny how that works."
                          ]
                        ]
                      ],
                      [
                        "say",
                        "",
                        "Tobin wheels the crates down the north road. One hums all the way out of sight."
                      ],
                      [
                        "setFlag",
                        "story.rc_end",
                        "shipped"
                      ],
                      [
                        "setFlag",
                        "story.rc_climax",
                        true
                      ]
                    ],
                    [
                      [
                        "say",
                        "Associate Tobin",
                        "Hey! Those crates were counted. Dorian checks the count at dawn."
                      ],
                      [
                        "say",
                        "Rook",
                        "Count again, Tobin. They're Pebblits. They napped in that seam before any of us were born."
                      ],
                      [
                        "say",
                        "Associate Tobin",
                        "I just pack, Rook. You used to just pack too."
                      ],
                      [
                        "battle",
                        "rc_tobin"
                      ],
                      [
                        "if",
                        "story.rc_tobin_result=won",
                        [
                          [
                            "say",
                            "Associate Tobin",
                            "Fine. FINE. I'll write 'escaped'. They do look happier."
                          ]
                        ],
                        [
                          [
                            "say",
                            "Associate Tobin",
                            "Ha! Still, my arms are tired. I'll write 'escaped'. Don't tell Dorian."
                          ]
                        ]
                      ],
                      [
                        "say",
                        "",
                        "Master Hale comes up the north road with a lantern and swings the shiny gate wide open."
                      ],
                      [
                        "say",
                        "Master Hale",
                        "Stone remembers who stood where. In you go, little ones."
                      ],
                      [
                        "say",
                        "",
                        "Three Pebblits roll into the warm seam. The rock rumbles softly, like a purr."
                      ],
                      [
                        "setFlag",
                        "story.rc_end",
                        "freed"
                      ],
                      [
                        "setFlag",
                        "story.rc_climax",
                        true
                      ],
                      [
                        "say",
                        "Rook",
                        "{name}. Dorian left my old lanyard on the cart seat. I still have it."
                      ],
                      [
                        "say",
                        "Rook",
                        "It's not for me anymore. But if you ever want to see their side, I can get you in."
                      ],
                      [
                        "choice",
                        "Rook's lanyard",
                        [
                          [
                            "Not ever",
                            [
                              [
                                "say",
                                "Rook",
                                "Good answer. I'd have walked you back out anyway."
                              ]
                            ]
                          ],
                          [
                            "Maybe someday",
                            [
                              [
                                "say",
                                "Rook",
                                "Then I'll hang onto it. Find me by the Brinewick road."
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ],
                [
                  [
                    "say",
                    "Rook",
                    "Crates first. Three in the yard, all humming. I'll keep Tobin talking."
                  ]
                ]
              ]
            ],
            [
              [
                "say",
                "Rook",
                "Crates first. Three in the yard, all humming. I'll keep Tobin talking."
              ]
            ]
          ]
        ],
        [
          [
            "say",
            "Rook",
            "Crates first. Three in the yard, all humming. I'll keep Tobin talking."
          ]
        ]
      ]
    ],
    "rc_wrap_hale": [
      [
        "say",
        "Master Hale",
        "The Old Seam is purring again, {name}. I heard it from my kettle."
      ],
      [
        "if",
        "story.rc_end=walked",
        [
          [
            "say",
            "Master Hale",
            "Rook says you walked away from a lanyard. Takes more nerve than any trial."
          ]
        ],
        [
          [
            "say",
            "Master Hale",
            "Forty years I dug beside Pebblits. Tonight I got to give some back."
          ]
        ]
      ],
      [
        "give",
        "befriend_treat",
        3
      ],
      [
        "give",
        "hearty_snack",
        2
      ],
      [
        "say",
        "Master Hale",
        "For the road to Brinewick, once it opens. Tell the Master there old Hale says hello."
      ],
      [
        "setFlag",
        "story.rc_done",
        true
      ]
    ],
    "rc_wrap_juniper": [
      [
        "say",
        "Associate Juniper",
        "The count's in! Three units, comfy and on their way. You're a natural, partner!"
      ],
      [
        "if",
        "story.rc_loose>=1",
        [
          [
            "say",
            "Associate Juniper",
            "Small note: one lid was loose. Tobin fixed it. We won't put it in your review!"
          ]
        ],
        [
          [
            "say",
            "Associate Juniper",
            "Not one lid loose. Dorian will hear about this. In a good way!"
          ]
        ]
      ],
      [
        "give",
        "energy_sip",
        2
      ],
      [
        "give",
        "joy_crumb",
        2
      ],
      [
        "say",
        "Associate Juniper",
        "Bonus Acorns are on the way. Have a bright day!"
      ],
      [
        "setFlag",
        "story.rc_done",
        true
      ]
    ],
    "rook_after": [
      [
        "if",
        "story.route3_open",
        [
          [
            "say",
            "Rook",
            "The road's open now. Brinewick's gate isn't. Not yet."
          ]
        ],
        [
          [
            "if",
            "story.rc_end=shipped",
            [
              [
                "say",
                "Rook",
                "Still here. Still closed. The road, I mean. Not me."
              ]
            ],
            [
              [
                "say",
                "Rook",
                "Pebblits are still purring. I check every morning. Don't tell anyone."
              ]
            ]
          ]
        ]
      ],
      [
        "if",
        "story.lizzy_met",
        [
          [
            "say",
            "Rook",
            "Lizzy sent soup and a lecture. The soup was better. Don't tell her."
          ]
        ]
      ],
      [
        "choice",
        "Rook",
        [
          [
            "How are you?",
            [
              [
                "say",
                "Rook",
                "Better. Mom says I sleep now. I say she snores. We're both right."
              ]
            ]
          ],
          [
            "See you",
            []
          ]
        ]
      ]
    ]
  },
