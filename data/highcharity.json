  "scenes": {
    "hc_council": [
      ["say", "Captain Lumen", "Both Seals are here. Fernbrook first, then Cobblecrest. The lanterns watched you walk."],
      ["if", "story.hc_invite", [
        ["say", "Captain Lumen", "Ilse's letter arrived ahead of you. She said the Seals would."]
      ]],
      ["say", "Captain Lumen", "The coastal road to Brinewick is on the board. We are not opening it."],
      ["say", "", "The chart names the road. The light beside it stays dark."],
      ["standing", "keepers", null, "hc_council_k"],
      ["say", "", "COMING LATER · The Keepers' next lantern. Thanks for playing!"],
      ["setFlag", "story.hc_council_done", true]
    ],
    "hc_invite": [
      [
        "if",
        "!story.side_pick_done",
        [
          [
            "say",
            "Warden Ilse",
            "Choose a side in Fernbrook first. Then I can send you."
          ]
        ],
        [
          [
            "if",
            "story.side=glimmer",
            [
              [
                "say",
                "Warden Ilse",
                "The capital wrote. They are polite about your lanyard. The hall is still open. Go play."
              ]
            ],
            [
              [
                "say",
                "Warden Ilse",
                "A letter came from the capital. High Charity is lighting its hall. Take {pet} and play."
              ]
            ]
          ],
          [
            "choice",
            "Will you go?",
            [
              [
                "I'll go",
                [
                  [
                    "say",
                    "Warden Ilse",
                    "Good. The lantern coach is just south of the Lodge door."
                  ],
                  [
                    "setFlag",
                    "story.hc_invite",
                    true
                  ]
                ]
              ],
              [
                "Not yet",
                [
                  [
                    "say",
                    "Warden Ilse",
                    "The letter will keep. The coach can wait."
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    "hc_ilse_done": [
      [
