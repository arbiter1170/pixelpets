  "save": {
    "field": "S.rep",
    "shape": "{ \"<contactKey(name)>\": int 0..100 }, sparse: only NPCs whose value differs from base",
    "normalize": "save.js normalizeV2: fill(s, 'rep', isPlainObject, {}); drop keys that are not strings <= 40; clamp ints 0..100; drop fixed NPCs. v stays 2, key stays pixelpets.save.v2. Older builds keep the unknown field (normalizeV2 keeps unknown keys).",
    "no_log": "The +/- history is not saved. It is rebuilt from flags: every rep source in data (moral options, quest rows, joins) has a flag, so the compass can list what happened by checking which flags are set.",
    "joins": "S.repJoins = int (count of faction joins applied), additive, default 0. Lets a reload know the penalty for join n already ran."
  },
  "join": {
    "when": "story.side_pick_done turns true (first pick) and each switch via Rook (story.switch_via set, side changes)",
    "effect": "every NPC with personMet() true and faction == the side you did NOT join: rep -10 (clamped, fixed NPCs skipped)",
    "later": "NPCs met after the join start at base; the penalty is not back-dated (D178)"
  },
  "intensity": {
    "rule": "effective = rep + mod. mod = +10 when the NPC faction equals your side, -10 when it is the other side, 0 for none/fixed. The tier for dialog uses effective, clamped 0..100. The compass shows the raw number and the tier of effective.",
    "why": "Same number, different feel: a Keeper at 55 is warm to a Keeper player and cool to a Glimmerwell one."
  },
  "cond": {
    "scene": "\"rep:<Name>>=60\", \"rep:<Name><20\", \"reptier:<Name>=warm\" (effective tier)",
    "lines": "\"reptier=warm\" in an NPC lines map means the speaker",
    "impl": "game.js cond(): add rep: and reptier: prefixes next to standing."
  },
  "letter_quests": {
    "where": [
      "High Charity invite (story.hc_invite, Warden Ilse \"Read the letter\") - Ilse is fixed, so the tiers apply to who you show the letter to: Lizzy, Rook, Captain Lumen",
      "ROOK_CROSSROADS letter (rc_* flags) - Rook tiers"
    ],
    "samples": {
      "Lizzy": {
        "close": "High Charity! Read it twice, then read it to Buddy. He likes good news.",
        "warm": "High Charity wrote to YOU? That's huge. Buddy and I are thrilled.",
        "neutral": "High Charity. That's a big step. Be careful up there.",
        "cool": "Oh. A letter. That's nice. I have papers to grade.",
        "hostile": "I saw what you did to Mr. Gristle. Congratulations on the letter, I guess."
      },
      "Rook": {
        "close": "You got one too?! We're going together. No arguing.",
        "warm": "Huh. They picked you. Fine. They picked right.",
        "neutral": "A letter? Mine was probably lost in the mail.",
        "cool": "Great. Another reason for everyone to clap for you.",
        "hostile": "Keep your letter. I don't need High Charity."
      },
      "Captain Lumen": {
        "close": "Good. Bring that letter and your best manners. You've earned both.",
        "warm": "The Keepers will be glad to see you there.",
        "neutral": "Present it at the gate. They check the seal.",
        "cool": "Letters are easy to get. Keeping them is harder.",
        "hostile": "I will be watching what you do with that letter."
      }
    },
    "intensity_example": "Captain Lumen at rep 55: Keeper player -> effective 65 (warm); Glimmerwell player -> effective 45 (neutral)."
  },
  "quest_moves": "Each quest that changes rep lists it in data (moral options; plain quests may add a \"rep\" step). No hidden moves.",
