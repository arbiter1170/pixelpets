  "scenes": {
    "ans_open": [
      [
        "say",
        "Archivist Mo",
        "You walked the Brinewick road. Then you heard it too. That low hum past the crates."
      ],
      [
        "say",
        "Archivist Mo",
        "Long before the lamps, they built tools to carry it. A counter, a lamp, a crow, a tether, a wisp."
      ],
      [
        "say",
        "Archivist Mo",
        "The hum woke all five. My books call them the Answerers. The page on what they answer stays blank."
      ],
      [
        "say",
        "Archivist Mo",
        "Find them. Quiet them, or keep them. Look at your own hands either way."
      ],
      [
        "setFlag",
        "story.ans_open",
        true
      ],
      [
        "say",
        "Archivist Mo",
        "Start with the old census post on Route 2. It never stopped counting."
      ]
    ],
    "ans_open@glimmer": [
      [
        "say",
        "Associate Quinn",
        "You made it down the Brinewick road. Good. This is the next quarter."
      ],
      [
        "say",
        "Associate Quinn",
        "Before the chips, we built five relays. A counter, a lamp, a crow, a tether, a wisp."
      ],
      [
        "say",
        "Associate Quinn",
        "The hum woke them and they walked off the books. Relay coverage is our proudest number. Five are missing."
      ],
      [
        "say",
        "Associate Quinn",
        "Bring the units home. Nothing sharp. Nothing cold."
      ],
      [
        "setFlag",
        "story.ans_open",
        true
      ],
      [
        "say",
        "Associate Quinn",
        "The census post on Route 2 is still counting. Start there. Have a bright day."
      ]
    ],
    "ans_clue_tallybat": [
      [
        "say",
        "",
        "An old Glow Census post. The counter clicks with nobody near it: 4, 4, 4, 4."
      ],
      [
        "say",
        "",
        "Fresh tally marks run off the post and down the road. Something is still counting, east of here."
      ],
      [
        "setFlag",
        "story.ans_tallybat_clue",
        true
      ]
    ],
    "ans_clue_dimlamp": [
      [
        "say",
        "",
        "A Comfort Lamp on a stake, set to RELAY. Beside it stands an empty stake and a cut cord."
      ],
      [
        "say",
        "",
        "A tag on the pole: LAMP COUNT 11 OF 12. The twelfth walked off toward the Brinewick road."
      ],
      [
        "setFlag",
        "story.ans_dimlamp_clue",
        true
      ]
    ],
    "ans_clue_filecrow": [
      [
        "say",
        "",
        "A box of old Keeper reports. One page is new, in Mo's hand: CROW. FILES. SEEN ON THE BRINEWICK ROAD."
      ],
      [
        "say",
        "",
        "Under it sits a RegenX folder label. Somebody filed it in the wrong archive, on purpose."
      ],
      [
        "setFlag",
        "story.ans_filecrow_clue",
        true
      ]
    ],
    "ans_clue_filecrow@glimmer": [
      [
        "say",
        "",
        "A fifth file cart, wheels unlocked. Its drawer is empty except for one black feather."
      ],
      [
        "say",
        "",
        "The sign-out sheet says: RELOCATED, BRINEWICK ROAD OFFICE. Nobody signed it."
      ],
      [
        "setFlag",
        "story.ans_filecrow_clue",
        true
      ]
    ],
    "ans_clue_cordhound": [
      [
        "say",
        "",
        "A chewed cord trails from the BRINEWICK DOCKS crates and down the open road."
      ],
      [
        "say",
        "",
        "Small paw prints walk beside it. They stop at every crate, then go on."
      ],
      [
        "setFlag",
        "story.ans_cordhound_clue",
        true
      ]
    ],
    "ans_clue_humwisp": [
      [
        "say",
        "",
        "The old mast hums. It never hummed before."
      ],
      [
        "say",
        "",
        "The four went quiet. The fifth got louder. It waits where the Brinewick road ends."
      ],
      [
        "setFlag",
        "story.ans_humwisp_clue",
        true
      ]
    ],
    "ans_clue_humwisp@glimmer": [
      [
        "say",
        "",
        "The cradle hums low. Its cursor spells COUNT. GATHER. LISTEN. Then one more word: ANSWER."
      ],
      [
        "say",
        "",
        "A note on the glass, in Quinn's hand: THE FIFTH IS AT THE RELAY HOUSE. END OF THE ROAD."
      ],
      [
        "setFlag",
        "story.ans_humwisp_clue",
        true
      ]
    ],
    "ans_tallybat": [
      [
        "say",
        "",
        "A bat hangs from the tally gate, counting crates that are not there. It counts you. Twice."
      ],
      [
        "encounter",
        "ans_tallybat"
      ],
      [
        "if",
        "story.ans_tallybat",
        [
          [
            "say",
            "",
            "It stops counting. It folds its wings and settles near {pet}."
          ]
        ],
        [
          [
            "say",
            "",
            "The tally clicks on. It is still counting, somewhere close."
          ]
        ]
      ]
    ],
    "ans_dimlamp": [
      [
        "say",
        "",
        "A lamp-headed shade glows between the cots. Its light asks you to sit down and stay."
      ],
      [
        "encounter",
        "ans_dimlamp"
      ],
      [
        "if",
        "story.ans_dimlamp",
        [
          [
            "say",
            "",
            "Its glow turns soft and stays soft. It follows {pet} out to the road."
          ]
        ],
        [
          [
            "say",
            "",
            "The lamps dim. The room waits for another visitor."
          ]
        ]
      ]
    ],
    "ans_filecrow": [
      [
        "say",
        "",
        "A crow with a file-card chest perches on the ledger. It files your name before you say it."
      ],
      [
        "encounter",
        "ans_filecrow"
      ],
      [
        "if",
        "story.ans_filecrow",
        [
          [
            "say",
            "",
            "It closes the ledger and hops over to {pet}, light as paper."
          ]
        ],
        [
          [
            "say",
            "",
            "It flips a card over: FILE PENDING."
          ]
        ]
      ]
    ],
    "ans_cordhound": [
      [
        "say",
        "",
        "A shadow pup paces the cargo yard on a cord nobody holds. The crates hum when it passes."
      ],
      [
        "encounter",
        "ans_cordhound"
      ],
      [
        "if",
        "story.ans_cordhound",
        [
          [
            "say",
            "",
            "It drops the cord at your feet and wags once."
          ]
        ],
        [
          [
            "say",
            "",
            "The cord pulls tight. The pup is back among the crates."
          ]
        ]
      ]
    ],
    "ans_humwisp": [
      [
        "say",
        "",
        "The relay hums so low you feel it in your teeth. A wisp drifts off the old machine and turns to you."
      ],
      [
        "encounter",
        "ans_humwisp"
      ],
      [
        "if",
        "story.ans_humwisp",
        [
          [
            "say",
            "",
            "The hum drops to a whisper. The wisp curls beside {pet}, and the relay goes quiet."
          ]
        ],
        [
          [
            "say",
            "",
            "The wisp sinks back into the hum. The relay keeps calling."
          ]
        ]
      ]
    ],
    "ans_close": [
      [
        "say",
        "Archivist Mo",
        "Five. All of them."
      ],
      [
        "say",
        "Archivist Mo",
        "Their hum is smaller now. Smaller is not gone. I wrote that down too."
      ],
      [
        "acorns",
        500
      ],
      [
        "setFlag",
        "story.ans_all",
        true
      ]
    ],
    "ans_close@glimmer": [
      [
        "say",
        "Associate Quinn",
        "All five relays are home. That is a very good quarter."
      ],
      [
        "say",
        "Associate Quinn",
        "The cradle is calmer. Do not ask me what that means. I would not know."
      ],
      [
        "acorns",
        500
      ],
      [
        "setFlag",
        "story.ans_all",
        true
      ]
    ]
  },
