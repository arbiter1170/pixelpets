  "scenes": {
    "sig_open": [
      [
        "say",
        "Archivist Mo",
        "You walked the Brinewick road. Then you heard it too. That low hum past the crates."
      ],
      [
        "say",
        "Archivist Mo",
        "Five tools of theirs woke when the hum got loud. A counter, a lamp, an owl, a tether, a wisp."
      ],
      [
        "say",
        "Archivist Mo",
        "My books call them the Answerers. They answer something we cannot name. That page stays blank."
      ],
      [
        "say",
        "Archivist Mo",
        "Find them. Quiet them, or keep them. Look at your own hands either way."
      ],
      [
        "setFlag",
        "story.sig_open",
        true
      ],
      [
        "say",
        "Archivist Mo",
        "Start with the old census post on Route 2. It never stopped counting."
      ]
    ],
    "sig_open@glimmer": [
      [
        "say",
        "Associate Quinn",
        "You made it down the Brinewick road. Good. I need someone who does not flinch."
      ],
      [
        "say",
        "Associate Quinn",
        "Five of our tools woke on their own. A counter, a lamp, an owl, a tether, a wisp."
      ],
      [
        "say",
        "Associate Quinn",
        "We do not know what woke them. The old ones built the cradle. That is all I was told."
      ],
      [
        "say",
        "Associate Quinn",
        "Bring the units home. Nothing sharp. Nothing cold."
      ],
      [
        "setFlag",
        "story.sig_open",
        true
      ],
      [
        "say",
        "Associate Quinn",
        "The census post on Route 2 is still counting. Start there. Have a bright day."
      ]
    ],
    "sig_clue_tallybat": [
      [
        "say",
        "",
        "An old Glow Census post. The counter clicks with nobody near it: 4, 4, 4, 4."
      ],
      [
        "say",
        "",
        "Fresh tally marks run off the post and down the road. Something is still counting, east of here."
      ],
      [
        "setFlag",
        "story.sig_tallybat_clue",
        true
      ]
    ],
    "sig_clue_hushlamp": [
      [
        "say",
        "",
        "One Comfort Lamp still stands. It is lit, though its cord is cut."
      ],
      [
        "say",
        "",
        "A tag on the pole: LAMP COUNT 11 OF 12. The twelfth walked off down the Brinewick road."
      ],
      [
        "setFlag",
        "story.sig_hushlamp_clue",
        true
      ]
    ],
    "sig_clue_ledgerowl": [
      [
        "say",
        "",
        "A box of old Keeper reports. One page is new, in Mo's hand: OWL. FILES. SEEN ON THE BRINEWICK ROAD."
      ],
      [
        "say",
        "",
        "Under it sits a RegenX folder label. Somebody filed it in the wrong archive, on purpose."
      ],
      [
        "setFlag",
        "story.sig_ledgerowl_clue",
        true
      ]
    ],
    "sig_clue_ledgerowl@glimmer": [
      [
        "say",
        "",
        "A fifth file cart, wheels unlocked. Its drawer is empty except for a sliver of screen glass."
      ],
      [
        "say",
        "",
        "The sign-out sheet says: RELOCATED, BRINEWICK ROAD OFFICE. Nobody signed it."
      ],
      [
        "setFlag",
        "story.sig_ledgerowl_clue",
        true
      ]
    ],
    "sig_clue_cordhound": [
      [
        "say",
        "",
        "A chewed cord trails from the BRINEWICK DOCKS crates and down the open road."
      ],
      [
        "say",
        "",
        "Small paw prints walk beside it. They stop at every crate, then go on."
      ],
      [
        "setFlag",
        "story.sig_cordhound_clue",
        true
      ]
    ],
    "sig_clue_humwisp": [
      [
        "say",
        "",
        "The old mast hums. It never hummed before."
      ],
      [
        "say",
        "",
